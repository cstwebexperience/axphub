# Stripe — cheia secretă din dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...

# Stripe webhook — signing secret din dashboard.stripe.com/webhooks
# (endpoint: https://axphub.ro/api/stripe-webhook · event: checkout.session.completed)
STRIPE_WEBHOOK_SECRET=whsec_...

# Resend — pentru emailul de comandă (resend.com/api-keys)
RESEND_API_KEY=re_...
# Unde ajunge emailul de comandă (poți pune mai multe, separate prin virgulă)
MAIL_TO=axpcontact00293@gmail.com
# Expeditor. onboarding@resend.dev merge fără domeniu verificat (dar Resend livrează
# doar către emailul contului tău). Pentru livrare la axpcontact, verifică axphub.ro în Resend
# și pune: MAIL_FROM=AXP Hub Comenzi <comenzi@axphub.ro>
MAIL_FROM=AXP Hub Comenzi <onboarding@resend.dev>

# Sameday API — credențialele primite de la Sameday în contract
SAMEDAY_USERNAME=username_din_contract
SAMEDAY_PASSWORD=parola_din_contract

# URL API Sameday (demo pentru testare, producție pentru live)
# Demo:      https://sameday-api.demo.zitec.com
# Producție: https://api.sameday.ro
SAMEDAY_API_URL=https://sameday-api.demo.zitec.com
