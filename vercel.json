{
  "version": 2,
  "builds": [
    { "src": "api/*.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api/create-checkout", "dest": "/api/create-checkout.js" },
    { "src": "/api/lockers",         "dest": "/api/lockers.js" },
    { "src": "/assets/(.*)",         "dest": "/assets/$1" },
    { "src": "/(.*\\.(css|js|jpg|jpeg|png|webp|mp4|glb|ico|svg|woff2?))", "dest": "/$1" },
    { "src": "/(.*)",                "dest": "/index.html" }
  ]
}
