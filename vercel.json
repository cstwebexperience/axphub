{
  "version": 2,
  "builds": [
    { "src": "api/create-checkout.js", "use": "@vercel/node" },
    { "src": "api/stripe-webhook.js",  "use": "@vercel/node" },
    { "src": "api/order-notify.js",    "use": "@vercel/node" },
    { "src": "api/lockers.js",         "use": "@vercel/node" },
    { "src": "index.html",             "use": "@vercel/static" },
    { "src": "termeni-conditii.html",  "use": "@vercel/static" },
    { "src": "politica-confidentialitate.html", "use": "@vercel/static" },
    { "src": "politica-cookies.html",  "use": "@vercel/static" },
    { "src": "politica-retur.html",    "use": "@vercel/static" },
    { "src": "styles.css",             "use": "@vercel/static" },
    { "src": "script.js",              "use": "@vercel/static" },
    { "src": "assets/**",              "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/create-checkout", "dest": "/api/create-checkout.js" },
    { "src": "/api/stripe-webhook",  "dest": "/api/stripe-webhook.js" },
    { "src": "/api/order-notify",    "dest": "/api/order-notify.js" },
    { "src": "/api/lockers",         "dest": "/api/lockers.js" },
    { "src": "/(.*)",                "dest": "/$1" }
  ]
}
